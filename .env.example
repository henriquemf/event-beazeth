# Flask
# Em produção a SECRET_KEY assina o cookie de sessão: quem souber a chave entra
# como qualquer conta. Gere a sua e não reaproveite a do exemplo.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=troque-esta-chave
DEBUG=False
ENABLE_DESKTOP_NOTIFICATIONS=False

# Banco. Obrigatória: o app não sobe sem ela.
# Local (docker compose up -d):  postgresql://dev:dev@127.0.0.1:5433/event_beazeth
# Neon/Supabase: copie a connection string do painel (mantenha o sslmode=require)
DATABASE_URL=postgresql://dev:dev@127.0.0.1:5433/event_beazeth

# Web Push (VAPID)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:voce@exemplo.com
